# ── Git ──
.git
.gitignore
.gitattributes

# ── 依赖缓存 ──
app/node_modules/
app/.bun-cache/
client/node_modules/
client/.bun-cache/

# ── 构建产物 ──
app/dist/
dist/
app/native/target/
client/src-tauri/target/

# ── 运行时数据 ──
app/data/
