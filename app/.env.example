# ============================================
# Liri 环境配置
# ============================================
# 首次使用：复制此文件为 .env，然后填写必填项即可
#   cp .env.example .env
#
# 必填项说明：
#   配置 API 密钥有两种方式（任选其一即可）：
#
#   方式一（推荐 — 统一格式，支持任意供应商）：
#     PROVIDER_DEEPSEEK_KEY=sk-xxx
#     PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
#     PROVIDER_DEEPSEEK_MODEL=deepseek-chat
#
#   方式二（大厂专用变量名，向后兼容）：
#     DEEPSEEK_API_KEY=sk-xxx
#
#   两种方式同时存在时，统一格式（PROVIDER_*）优先
#   应用会自动检测所有环境变量中的 API Key
#
#   如不配置 API 密钥，应用将以离线模式运行，AI 对话不可用
#   其他配置项有默认值，首次使用无需修改
# ============================================

# ---- AI 模型配置（必填，任选一种方式） ----

# 方式一（推荐）：统一 PROVIDER_ 格式，支持任意供应商
# 命名规则：PROVIDER_{供应商大写}_{KEY|BASE_URL|MODEL}
#   PROVIDER_DEEPSEEK_KEY=sk-xxx
#   PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
#   PROVIDER_DEEPSEEK_MODEL=deepseek-chat
#
#   PROVIDER_OPENAI_KEY=sk-xxx
#   PROVIDER_OPENAI_BASE_URL=https://api.openai.com
#   PROVIDER_OPENAI_MODEL=gpt-4o
#
#   PROVIDER_ANTHROPIC_KEY=sk-ant-xxx
#   PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com
#   PROVIDER_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 方式二（向后兼容）：大厂专用变量名
# DeepSeek API 密钥（获取: https://platform.deepseek.com/api_keys）
# DEEPSEEK_API_KEY=在此填入你的 DeepSeek API 密钥
# API 地址（默认即可）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称（默认即可）
# DEEPSEEK_MODEL=deepseek-chat

# ---- 应用配置 ----
APP_NAME=Liri
APP_VERSION=1.0.0

# ---- 部署配置 ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- 安全配置 ----
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=*
SECURITY_AUDIT_ENABLED=true
SECURITY_AUDIT_LOG_FILE=app/data/logs/security_audit.log
SECURITY_AUDIT_RETENTION_DAYS=30
SECURITY_AUDIT_MAX_LOG_SIZE=100
SECURITY_AUDIT_VERBOSE=false
SECURITY_INPUT_VALIDATION_ENABLED=true
SECURITY_OUTPUT_ENCODING_ENABLED=true
SECURITY_DANGEROUS_COMMAND_CHECK=true
SECURITY_PATH_TRAVERSAL_CHECK=true
SECURITY_XSS_PROTECTION_ENABLED=true
SECURITY_UNICODE_SANITIZATION_ENABLED=true
SECURITY_PERMISSION_ENFORCEMENT=true
SECURITY_MAX_INPUT_LENGTH=4096
SECURITY_MAX_FILE_PATH_LENGTH=1024
SECURITY_ALLOWED_PROTOCOLS=http,https,ftp

# ---- 日志配置 ----
LOG_LEVEL=debug
LOG_FILE=app/data/logs/app.log
SECURITY_LOG_LEVEL=info

# ---- 数据库配置 ----
DATABASE_PATH=app/data/py_copilot.db

# ---- 权限配置 ----
PERMISSION_MODE=DEFAULT

# ---- 性能配置 ----
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30000

# ---- 工具配置 ----
TOOL_EXECUTION_TIMEOUT=60000

# ---- 通道配置 ----
# WECHAT_BOT_HTTP_URL=http://localhost:7600  # 个人微信 Bot (weixin-cli) HTTP 地址
# 安装: npx -y @tencent-weixin/openclaw-weixin-cli@latest install

# ---- 图片生成配置（至少配置一项才能使用 /image 页面的生成功能） ----
# 选项 1：OpenAI DALL-E 3（获取: https://platform.openai.com/api_keys）
# OPENAI_API_KEY=sk-your-key-here

# 选项 2：Stability AI（获取: https://platform.stability.ai/account/keys）
# STABILITY_API_KEY=sk-your-key-here

# 选项 3：Replicate Flux（获取: https://replicate.com/account/api-tokens）
# REPLICATE_API_KEY=your-key-here

# 选项 4：本地 SD WebUI（需本地运行 Automatic1111 或 ComfyUI）
# SD_WEBUI_URL=http://127.0.0.1:7860

# ---- 音乐生成配置 ----
# SUNO_API_KEY=sk-your-key-here  # Suno API 密钥

# ---- QQ Bot 配置 ----
# 注册地址: https://q.qq.com/
# QQ_APP_ID=               # QQ Bot AppID
# QQ_APP_SECRET=           # QQ Bot AppSecret
# QQ_HOME_CHANNEL_ID=      # 默认发送目标（QQ 群号/频道号），可选
