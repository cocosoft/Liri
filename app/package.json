{
  "name": "openliri",
  "version": "0.1.0",
  "description": "Liri — 你的 AI 私人助手,基于 TypeScript + Rust 架构",
  "license": "MIT",
  "type": "module",
  "main": "src/main.ts",
  "bin": {
    "Liri": "./src/main.ts",
    "liri-memory": "./src/cli.ts",
    "liri-ink": "./src/cli/simple-ink-cli.tsx"
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "bun build src/main.ts --outdir=dist --target=bun",
    "build:core": "cross-env LIRI_BUILD_VARIANT=core bun run scripts/build-variant.ts --variant=core",
    "build:personal": "cross-env LIRI_BUILD_VARIANT=personal bun run scripts/build-variant.ts --variant=personal",
    "build:coding": "cross-env LIRI_BUILD_VARIANT=coding bun run scripts/build-variant.ts --variant=coding",
    "build:enterprise": "cross-env LIRI_BUILD_VARIANT=enterprise bun run scripts/build-variant.ts --variant=enterprise",
    "build:mac": "bun run scripts/build-variant.ts --variant=coding && bun build --compile --target=bun-darwin-arm64-modern --external pdfjs-dist --external sharp --outfile=../dist/py_app_coding src/pyapp.ts",
    "build:mac-intel": "bun run scripts/build-variant.ts --variant=coding && bun build --compile --target=bun-darwin-x64-modern --external pdfjs-dist --external sharp --outfile=../dist/py_app_coding src/pyapp.ts",
    "build:win": "bun run scripts/build-variant.ts --variant=personal && bun build --compile --target=bun-windows-x64-modern --external pdfjs-dist --external sharp --outfile=../dist/py_app_coding src/pyapp.ts && bun run scripts/copy-external-deps.ts",
    "build:win:coding": "bun run scripts/build-variant.ts --variant=coding && bun build --compile --target=bun-windows-x64-modern --external pdfjs-dist --external sharp --outfile=../dist/py_app_coding src/pyapp.ts && bun run scripts/copy-external-deps.ts",
    "build:linux": "bun run scripts/build-variant.ts --variant=coding && bun build --compile --target=bun-linux-x64-modern --external pdfjs-dist --external sharp --outfile=../dist/py_app_coding src/pyapp.ts && bun run scripts/copy-external-deps.ts",
    "build:linux-arm64": "bun run scripts/build-variant.ts --variant=coding && bun build --compile --target=bun-linux-arm64-modern --external pdfjs-dist --external sharp --outfile=../dist/py_app_coding src/pyapp.ts && bun run scripts/copy-external-deps.ts",
    "build:exe": "bun run scripts/build-variant.ts --variant=coding && bun build --compile --target=bun-windows-x64-modern --external pdfjs-dist --external sharp --outfile=../dist/py_app src/pyapp.ts",
    "build:dry-run": "bun run scripts/build-variant.ts --dry-run",
    "security-scan": "bun run src/scripts/security-scan.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:reporter": "bun run test-reporter.ts",
    "memory": "bun run src/cli.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "codegen": "bun run src/tools/codegen/cli.ts",
    "health": "bun run src/healthcheck.ts",
    "monitor": "bun run src/monitor.ts",
    "deploy": "bash deploy.sh",
    "deploy:docker": "docker-compose up -d",
    "stop:docker": "docker-compose down",
    "check:paths": "bun run scripts/check-paths.ts",
    "ci": "bun run typecheck && bun run lint && bun run check:paths && bun test",
    "ci:full": "bun run ci && bun run test:coverage",
    "modules:test": "bun test src/tests/ModuleSystem.test.ts",
    "modules:analyze": "bun run scripts/migrate-modules.ts",
    "modules:migrate": "bun run scripts/migrate-modules.ts --execute",
    "modules:validate": "bun run src/tools/DependencyValidator.ts",
    "modules:scan": "bun run src/tools/DependencyGraphScanner.ts",
    "modules:snapshot": "bun run scripts/export-dependency-snapshot.ts",
    "modules:init": "bun run src/main.ts --repl",
    "modules:check": "bun test src/tests/ModuleSystem.test.ts && bun run scripts/migrate-modules.ts && bun run src/tools/DependencyValidator.ts",
    "modules:setup": "bun run scripts/setup-git-hooks.ts",
    "plugify": "bun run src/scripts/plugify.ts",
    "native:build": "cd native && cargo build --release",
    "native:build:debug": "cd native && cargo build",
    "native:test": "cd native && cargo test",
    "native:clean": "cd native && cargo clean",
    "native:check": "cd native && cargo check"
  },
  "keywords": [
    "ai",
    "agent",
    "typescript",
    "rust"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.0",
    "@growthbook/growthbook": "^1.6.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/sdk-trace-node": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "adm-zip": "^0.5.17",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "auto-bind": "^5.0.1",
    "axios": "^1.15.0",
    "bidi-js": "^1.0.3",
    "chalk": "^5.3.0",
    "cheerio": "^1.2.0",
    "clipboardy": "^5.3.1",
    "commander": "^12.1.0",
    "emoji-regex": "^10.6.0",
    "fast-xml-parser": "^5.7.3",
    "figures": "^6.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.4",
    "get-east-asian-width": "^1.5.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "https-proxy-agent": "^7.0.4",
    "ink": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.18.1",
    "mammoth": "^1.12.0",
    "msg.js": "^0.0.2",
    "outlook-email-parser": "^2.0.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.5",
    "react-devtools-core": "^7.0.1",
    "react-reconciler": "^0.33.0",
    "sharp": "^0.34.5",
    "signal-exit": "^4.1.0",
    "sqlite3": "^6.0.1",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.4.0",
    "usehooks-ts": "^2.16.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
