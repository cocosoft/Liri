    "@opentelemetry/sdk-trace-node": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "adm-zip": "^0.5.17",
    "auto-bind": "^5.0.1",
    "axios": "^1.15.0",
    "bidi-js": "^1.0.3",
    "chalk": "^5.3.0",
    "cheerio": "^1.2.0",
    "cli-boxes": "^4.0.1",
    "clipboardy": "^5.3.1",
    "code-excerpt": "^4.0.0",
    "commander": "^12.1.0",
    "croner": "^10.0.1",
    "dingtalk-stream": "2.1.5",
    "emoji-regex": "^10.6.0",
    "fast-xml-parser": "^5.7.3",
    "figures": "^6.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.4",
    "get-east-asian-width": "^1.5.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.9",
    "https-proxy-agent": "^7.0.4",
    "indent-string": "^5.0.0",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.18.1",
    "mammoth": "^1.12.0",
    "msg.js": "^0.0.2",
    "outlook-email-parser": "^2.0.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.5",
    "react-devtools-core": "^7.0.1",
    "react-reconciler": "^0.33.0",
    "sharp": "^0.34.5",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.4.0",
    "usehooks-ts": "^2.16.0",
    "uuid": "^13.0.0",
    "wrap-ansi": "^10.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "yoga-layout": "^3.2.1",
    "zod": "^3.23.0",
    "zustand": "^5.0.12"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.100"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "bun-types": "1.4.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
