{
  "name": "openliri",
  "version": "0.5.3",
  "description": "Liri — 你的 AI 私人助手,基于 TypeScript + Rust 架构",
  "homepage": "https://openliri.com",
  "license": "MIT",
  "type": "module",
  "main": "src/main.ts",
  "bin": {
    "Liri": "./src/main.ts",
    "liri-memory": "./src/cli/index.ts",
    "liri-ink": "./src/cli/simple-ink-cli.tsx"
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "dev:full": "bun run --watch src/main.ts",
    "dev:core": "bun --watch --feature=DROP_CHANNELS_ALL src/main.ts",
    "start": "bun run src/main.ts",
    "eval": "bun run src/evals/cli.ts",
    "build": "bun build src/main.ts --outdir=dist --target=bun --external imapflow --external yoga-layout",
    "build:core": "bun run scripts/build-variant.ts --variant=core",
    "build:personal": "bun run scripts/build-variant.ts --variant=personal",
    "build:coding": "bun run scripts/build-variant.ts --variant=coding",
    "build:enterprise": "bun run scripts/build-variant.ts --variant=enterprise",
    "build:win:coding": "bun -e \"import{existsSync,mkdirSync}from'fs';if(!existsSync('../dist'))mkdirSync('../dist',{recursive:true})\" && bun run scripts/build-variant.ts --variant=coding && bun build --compile --target=bun-windows-x64-modern --external pdfjs-dist --external sharp --external yoga-layout --compile-autoload-package-json --outfile=../dist/liri_terminal src/pyapp.ts && bun run scripts/copy-external-deps.ts && bun run scripts/copy-prompts.ts --target=../dist",
    "build:win:coding:dist": "bun run build:win:coding && bun run scripts/package-compile.ts --platform=win-x64",
    "build:core:bundle": "bun -e \"import{existsSync,mkdirSync}from'fs';if(!existsSync('../dist/pkg-core'))mkdirSync('../dist/pkg-core',{recursive:true})\" && bun run scripts/build-variant.ts --variant=core && bun build --target=bun --feature=DROP_CHANNELS_ALL --external sharp --external pdfjs-dist --external yoga-layout --outdir=../dist/pkg-core src/pyapp.ts",
    "build:headless": "bun -e \"import{existsSync,mkdirSync}from'fs';if(!existsSync('../dist/pkg-headless'))mkdirSync('../dist/pkg-headless',{recursive:true})\" && bun run scripts/build-variant.ts --variant=headless && bun build --target=bun --feature=DROP_UI --external sharp --external pdfjs-dist --external yoga-layout --outdir=../dist/pkg-headless src/pyapp.ts",
    "build:win:core": "bun -e \"import{existsSync,mkdirSync}from'fs';if(!existsSync('../dist'))mkdirSync('../dist',{recursive:true})\" && bun run scripts/build-variant.ts --variant=core && bun build --compile --target=bun-windows-x64-modern --feature=DROP_CHANNELS_ALL --external pdfjs-dist --external sharp --external yoga-layout --compile-autoload-package-json --outfile=../dist/liri_terminal_core src/pyapp.ts && bun run scripts/copy-external-deps.ts && bun run scripts/copy-prompts.ts --target=../dist",
    "build:mac": "bun -e \"import{existsSync,mkdirSync}from'fs';if(!existsSync('../dist'))mkdirSync('../dist',{recursive:true})\" && bun run scripts/build-variant.ts --variant=coding && bun build --compile --target=bun-darwin-arm64-modern --external pdfjs-dist --external sharp --external yoga-layout --compile-autoload-package-json --outfile=../dist/liri_terminal src/pyapp.ts && bun run scripts/copy-external-deps.ts && bun run scripts/copy-prompts.ts --target=../dist",
    "build:linux": "bun -e \"import{existsSync,mkdirSync}from'fs';if(!existsSync('../dist'))mkdirSync('../dist',{recursive:true})\" && bun run scripts/build-variant.ts --variant=coding && bun build --compile --target=bun-linux-x64-modern --external pdfjs-dist --external sharp --external yoga-layout --compile-autoload-package-json --outfile=../dist/liri_terminal src/pyapp.ts && bun run scripts/copy-external-deps.ts && bun run scripts/copy-prompts.ts --target=../dist",
    "build:bundle": "bun -e \"import{existsSync,mkdirSync}from'fs';if(!existsSync('../dist/pkg'))mkdirSync('../dist/pkg',{recursive:true})\" && bun run scripts/build-variant.ts --variant=personal && bun build --target=bun --external sharp --external pdfjs-dist --external yoga-layout --outdir=../dist/pkg src/pyapp.ts && bun -e \"import{renameSync}from'fs';renameSync('../dist/pkg/pyapp.js','../dist/pkg/liri.js')\" && bun run scripts/copy-prompts.ts --target=../dist/pkg",
    "build:runtime": "bun run scripts/copy-bun-runtime.ts --target=../dist/pkg",
    "build:deps": "bun run scripts/copy-external-deps.ts --target=../dist/pkg",
    "build:seed": "bun run scripts/copy-seed-data.ts --target=../dist/pkg",
    "build:package:win": "bun run build:bundle && bun run build:runtime && bun run build:deps && bun run build:seed && bun run scripts/package.ts --platform=win-x64",
    "build:update:win": "bun run build:bundle && bun run build:deps && bun run scripts/package.ts --platform=win-x64 --update-only",
    "build:dry-run": "bun run scripts/build-variant.ts --dry-run",
    "security-scan": "bun run src/scripts/security-scan.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.root-scripts.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:root-scripts": "tsc -p tsconfig.root-scripts.json --noEmit",
    "test": "bun test",
    "test:guarded": "bun run scripts/test-with-watchdog.ts",
    "test:watch": "bun test --watch",
    "test:serial": "bun test --concurrency=1",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:check-coverage": "bun run scripts/check-coverage-threshold.ts",
    "generate-test-images": "bun run scripts/generate-test-images.ts",
    "gen:toolnames": "bun run scripts/gen-tool-names.ts",
    "benchmark:startup": "bun run scripts/benchmark-startup.ts",
    "benchmark:compare": "bun run ../scripts/compare-performance-baseline.ts",
    "memory": "bun run src/cli/index.ts",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "lint:scripts": "cd .. && bun app/node_modules/eslint/bin/eslint.js --config app/eslint.scripts.config.js scripts",
    "lint:arch": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-architecture.ts",
    "lint:variant-matrix": "bun run scripts/lint-variant-matrix.ts",
    "lint:startup-graph": "bun run scripts/lint-startup-graph.ts",
    "lint:critical-modules": "bun run scripts/lint-critical-modules.ts",
    "lint:kernel-surface": "bun run scripts/lint-kernel-surface.ts",
    "lint:architecture-boundaries": "bun run scripts/lint-architecture-boundaries.ts",
    "lint:size": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-file-size.ts",
    "lint:models": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-models.ts",
    "lint:mock": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-mock.ts",
    "lint:unref": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-unref.ts",
    "lint:unref:list": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-unref.ts --list",
    "lint:session": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-session-regression.ts",
    "lint:legacy-env": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-legacy-env.ts",
    "lint:exit": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-script-exit.ts",
    "lint:case": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-case-collision.ts",
    "lint:refs": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-script-refs.ts",
    "lint:doc-code": "node ../scripts/check-doc-code-consistency.js",
    "lint:invariants": "bun run ../scripts/lint-invariants.ts",
    "lint:entrypoints": "bun run ../scripts/lint-entrypoints.ts",
    "lint:fix-evidence": "bun run ../scripts/lint-fix-evidence.ts",
    "lint:fn-size": "bun run ../scripts/lint-function-size-ratchet.ts",
    "lint:state-ratchet": "bun run ../scripts/lint-state-literal-ratchet.ts",
    "lint:complexity": "bun run scripts/lint-complexity-ratchet.ts",
    "lint:tool-schema": "bun run scripts/lint-tool-schema.ts",
    "lint:prompt-parity": "bun run scripts/lint-prompt-parity.ts",
    "lint:prompt-budget": "bun run scripts/lint-prompt-budget.ts",
    "lint:prompt-t1": "bun run scripts/lint-prompt-t1.ts",
    "lint:prompt-hardcoded": "bun run scripts/lint-prompt-hardcoded.ts --strict",
    "lint:capabilities": "bun run scripts/lint-capabilities.ts",
    "lint:no-module-mock": "bun run ../scripts/lint-no-module-mock.ts",
    "lint:consts": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-consts.ts",
    "lint:toolname-branches": "bun run ../scripts/count-toolname-branches.ts",
    "lint:endpoints": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-endpoints.ts",
    "lint:locale": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-locale.ts",
    "lint:failmsg-refs": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-failmsg-refs.ts",
    "lint:evidence-linewidth": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-evidence-linewidth.ts",
    "lint:evidence-views-drift": "PYAPP_PROJECT_DIR=.. bun run ../scripts/lint-evidence-views-drift.ts",
    "handoff": "bun run ../scripts/gen-handoff.ts",
    "prompts:export": "bun run scripts/export-prompts.ts",
    "prompts:check": "bun run scripts/export-prompts.ts --check",
    "params:export": "bun run scripts/export-tool-params.ts",
    "params:check": "bun run scripts/export-tool-params.ts --check",
    "descriptions:export": "bun run scripts/export-tool-descriptions.ts",
    "descriptions:check": "bun run scripts/export-tool-descriptions.ts --check",
    "measure:session-cost": "bun run ../scripts/measure-session-cost.ts",
    "lint:license": "bun run ../scripts/check-license-compliance.ts",
    "audit:complexity": "bun run scripts/state-complexity-audit.ts",
    "bench:otel": "bun run scripts/bench-otel-overhead.ts",
    "bench:mcp-redaction": "bun run scripts/bench-mcp-redaction.ts",
    "bench:eventlog-concurrency": "bun run scripts/bench-eventlog-concurrency.ts",
    "analyze:tool-search": "bun run scripts/analyze-tool-search.ts",
    "analyze:orchestration-events": "bun run scripts/analyze-orchestration-events.ts",
    "analyze:startup-graph": "bun run scripts/analyze-startup-graph.ts",
    "analyze:cpu-profile": "bun run scripts/analyze-cpu-profile.ts",
    "report:output-guard-corpus": "bun run scripts/report-output-guard-corpus.ts",
    "evidence:prompt-locale": "bun run scripts/compare-prompt-locale-behavior.ts",
    "evidence:verifier-role": "bun run scripts/verify-role-model-evidence.ts",
    "evidence:orchestration-window": "bun run scripts/measure-orchestration-window.ts",
    "evidence:tool-params-locale": "bun run scripts/verify-tool-params-locale.ts",
    "health:arch": "PYAPP_PROJECT_DIR=.. bun run ../scripts/architecture-health.ts --compare",
    "health:arch:json": "PYAPP_PROJECT_DIR=.. bun run ../scripts/architecture-health.ts --json",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "codegen": "bun run src/tools/codegen/cli.ts",
    "health": "bun run src/healthcheck.ts",
    "monitor": "bun run src/monitor.ts",
    "deploy": "bash deploy.sh",
    "deploy:docker": "docker-compose up -d",
    "stop:docker": "docker-compose down",
    "check:paths": "bun run scripts/check-paths.ts",
    "check:circular": "npx madge --circular --extensions ts,tsx src/",
    "i18n:check": "bun run scripts/i18n-snapshot.ts check",
    "i18n:snapshot": "bun run scripts/i18n-snapshot.ts snapshot",
    "version:sync": "bun run ../scripts/sync-version.ts",
    "version:check": "node ../scripts/check-version-consistency.js",
    "version:tag": "git tag v$(node -p \"require('./package.json').version\")",
    "prepare": "bun run scripts/setup-git-hooks.ts || echo '跳过'",
    "ci": "bun run typecheck && bun run lint && bun run lint:scripts && bun run lint:arch && bun run lint:variant-matrix && bun run lint:startup-graph && bun run lint:critical-modules && bun run lint:kernel-surface && bun run lint:architecture-boundaries && bun run lint:size && bun run lint:legacy-env && bun run lint:exit && bun run lint:case && bun run lint:unref && bun run lint:refs && bun run lint:doc-code && bun run lint:invariants && bun run lint:entrypoints && bun run lint:fix-evidence && bun run lint:fn-size && bun run lint:state-ratchet && bun run lint:complexity && bun run lint:tool-schema && bun run lint:toolname-branches && bun run lint:capabilities && bun run lint:no-module-mock && bun run lint:consts && bun run lint:endpoints && bun run lint:locale && bun run lint:failmsg-refs && bun run prompts:check && bun run params:check && bun run descriptions:check && bun run lint:prompt-parity && bun run lint:prompt-budget && bun run lint:prompt-t1 && bun run lint:prompt-hardcoded && bun run lint:evidence-linewidth && bun run lint:evidence-views-drift && bun run version:check && bun run check:paths && bun run i18n:check && bun run test:guarded",
    "ci:full": "bun run ci && bun run test:coverage && bun run test:check-coverage",
    "modules:test": "bun test src/tests/ModuleSystem.test.ts",
    "modules:analyze": "bun run scripts/migrate-modules.ts",
    "modules:migrate": "bun run scripts/migrate-modules.ts --execute",
    "modules:validate": "bun run src/tools/DependencyValidator.ts",
    "modules:scan": "bun run src/tools/DependencyGraphScanner.ts",
    "modules:snapshot": "bun run scripts/export-dependency-snapshot.ts",
    "modules:init": "bun run src/main.ts --repl",
    "modules:check": "bun test src/tests/ModuleSystem.test.ts && bun run scripts/migrate-modules.ts && bun run src/tools/DependencyValidator.ts",
    "modules:setup": "bun run scripts/setup-git-hooks.ts",
    "service:install": "bun run scripts/install-service.ts install",
    "service:uninstall": "bun run scripts/install-service.ts uninstall",
    "service:start": "bun run scripts/install-service.ts start",
    "service:stop": "bun run scripts/install-service.ts stop",
    "service:restart": "bun run scripts/install-service.ts restart",
    "service:status": "bun run scripts/install-service.ts status",
    "service:dev": "bun run scripts/install-service.ts install --dev",
    "plugify": "bun run src/scripts/plugify.ts",
    "native:build": "cd native && cargo build --release",
    "native:build:debug": "cd native && cargo build",
    "native:test": "cd native && cargo test",
    "native:clean": "cd native && cargo clean",
    "native:check": "cd native && cargo check"
  },
  "keywords": [
    "ai",
    "agent",
    "typescript",
    "rust"
  ],
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@growthbook/growthbook": "^1.6.5",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.215.0",
