{
  "name": "@pyapp/coding",
  "version": "1.0.0",
  "description": "Liri Coding — 含 LSP、Notebook、代码分析和浏览器工具的 AI Agent 功能包（注：与构建变体 pro 无关，包名 coding 保留为能力域名）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cd ../.. && bun run build:pro",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@pyapp/personal": "1.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "lsp",
    "notebook",
    "code-analysis",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}