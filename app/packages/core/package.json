{
  "name": "@pyapp/core",
  "version": "1.0.0",
  "description": "Liri Core — AI Agent 核心运行时，提供 CLI 接口和基础工具集",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./channels": {
      "types": "./dist/channels/index.d.ts",
      "import": "./dist/channels/index.js"
    },
    "./converter": {
      "types": "./dist/converter/index.d.ts",
      "import": "./dist/converter/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./plugins/sdk": {
      "types": "./dist/plugins/sdk/index.d.ts",
      "import": "./dist/plugins/sdk/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cd ../.. && bun run build:core",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/Liri"
  },
  "publishConfig": {
    "access": "public"
  }
}