{
  "1": {
    "inputs": { "ckpt_name": "wan2.2_t2v_14B_fp8_scaled.safetensors" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load Checkpoint (Wan)" }
  },
  "2": {
