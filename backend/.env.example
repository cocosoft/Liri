# ============================================
# PY_APP 环境配置
# ============================================
# 首次使用：复制此文件为 .env，然后填写必填项即可
#   cp .env.example .env
#
# 必填项说明：
#   1. DEEPSEEK_API_KEY — AI 对话功能所需密钥
#      获取方式：https://platform.deepseek.com/api_keys
#      注册 → 创建 API Key → 复制粘贴到下方
#      新用户注册即送 500 万 tokens 免费额度，无需付费即可使用
#
#   如不配置 API 密钥，应用将以离线模式运行，AI 对话不可用
#   其他配置项有默认值，首次使用无需修改
# ============================================

# ---- AI 模型配置（必填） ----
# DeepSeek API 密钥（获取: https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=在此填入你的 DeepSeek API 密钥
# API 地址（默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称（默认即可）
DEEPSEEK_MODEL=deepseek-chat

# ---- 应用配置 ----
APP_NAME=PY_APP
APP_VERSION=1.0.0

# ---- 部署配置 ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- 安全配置 ----
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=*
SECURITY_AUDIT_ENABLED=true
SECURITY_AUDIT_LOG_FILE=backend/logs/security_audit.log
SECURITY_AUDIT_RETENTION_DAYS=30
SECURITY_AUDIT_MAX_LOG_SIZE=100
SECURITY_AUDIT_VERBOSE=false
SECURITY_INPUT_VALIDATION_ENABLED=true
SECURITY_OUTPUT_ENCODING_ENABLED=true
SECURITY_DANGEROUS_COMMAND_CHECK=true
SECURITY_PATH_TRAVERSAL_CHECK=true
SECURITY_XSS_PROTECTION_ENABLED=true
SECURITY_UNICODE_SANITIZATION_ENABLED=true
SECURITY_PERMISSION_ENFORCEMENT=true
SECURITY_MAX_INPUT_LENGTH=4096
SECURITY_MAX_FILE_PATH_LENGTH=1024
SECURITY_ALLOWED_PROTOCOLS=http,https,ftp

# ---- 日志配置 ----
LOG_LEVEL=debug
LOG_FILE=backend/logs/app.log
SECURITY_LOG_LEVEL=info

# ---- 数据库配置 ----
DATABASE_PATH=backend/data/py_copilot.db

# ---- 权限配置 ----
PERMISSION_MODE=DEFAULT

# ---- 性能配置 ----
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30000

# ---- 工具配置 ----
TOOL_EXECUTION_TIMEOUT=60000
