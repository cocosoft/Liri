  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "packages", "src/tools/filesystem", "src/subagents", "src/subagent", "src/session", "src/sandbox", "src/services/SessionMemory", "src/plugins", "src/promptSuggestion", "src/memory", "src/permission", "src/skillCode", "src/mcp", "src/QueryEngine.ts", "src/llm", "src/hooks", "src/chat", "src/governance", "src/**/__tests__", "src/**/tests", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*ModuleTest.ts"]
