{
  "name": "liri-client",
  "version": "0.4.44",
  "description": "Liri Desktop Client",
  "homepage": "https://openliri.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "check:react": "node scripts/check-duplicate-react.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:tauri": "tauri build",
    "dist": "tauri build && node scripts/copy-dist.js",
    "dist:msi": "tauri build --bundles msi && node scripts/copy-dist.js",
    "dist:nsis": "tauri build --bundles nsis && node scripts/copy-dist.js"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@babel/core": "^8.0.1",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tanstack/react-virtual": "^3.14.7",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@types/dagre": "^0.7.54",
    "@types/react-window": "^1.8.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.0",
    "jsesc": "^3.1.0",
    "katex": "^0.17.0",
    "lucide-react": "1.25.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.15.0",
    "pptx-viewer": "^0.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
