{
  "name": "@openliri/infra",
  "version": "0.1.0",
  "private": true,
  "description": "Liri infra 包 —— 六层架构的 infra 层中**已物理独立**的模块（external / common）。仅 infra 层与上层可依赖；内核不得依赖本包。",
  "type": "module",
  "exports": {
    "./external": {
      "types": "./src/external/index.ts",
      "import": "./src/external/index.ts"
    },
    "./common": {
      "types": "./src/common/index.ts",
      "import": "./src/common/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "import": "./src/constants/index.ts"
    },
    "./constants/*": {
      "types": "./src/constants/*.ts",
      "import": "./src/constants/*.ts"
    },
    "./environment": {
      "types": "./src/environment/index.ts",
      "import": "./src/environment/index.ts"
    },
    "./environment/*": {
      "types": "./src/environment/*.ts",
      "import": "./src/environment/*.ts"
    },
    "./runtimeHost": {
      "types": "./src/runtimeHost/index.ts",
      "import": "./src/runtimeHost/index.ts"
    },
    "./runtimeHost/*": {
      "types": "./src/runtimeHost/*.ts",
      "import": "./src/runtimeHost/*.ts"
    },
    "./featureflags": {
      "types": "./src/featureflags/index.ts",
      "import": "./src/featureflags/index.ts"
    },
    "./featureflags/*": {
      "types": "./src/featureflags/*.ts",
      "import": "./src/featureflags/*.ts"
    },
    "./daemon": {
      "types": "./src/daemon/index.ts",
      "import": "./src/daemon/index.ts"
    },
    "./daemon/*": {
      "types": "./src/daemon/*.ts",
      "import": "./src/daemon/*.ts"
    },
    "./cache": {
      "types": "./src/cache/index.ts",
      "import": "./src/cache/index.ts"
    },
    "./cache/*": {
      "types": "./src/cache/*.ts",
      "import": "./src/cache/*.ts"
    },
    "./state": {
      "types": "./src/state/index.ts",
      "import": "./src/state/index.ts"
    },
    "./state/*": {
      "types": "./src/state/*.ts",
      "import": "./src/state/*.ts"
    }
  },
  "scripts": {
    "typecheck": "bun ../../app/node_modules/typescript/bin/tsc -p tsconfig.json"
  }
}
