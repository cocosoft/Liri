    "./profilerFacade": { "types": "./dist/core/profilerFacade.d.ts", "import": "./dist/core/profilerFacade.js" },
    "./profilerFacade.js": { "types": "./dist/core/profilerFacade.d.ts", "import": "./dist/core/profilerFacade.js" },
    "./abortReason": { "types": "./dist/core/abortReason.d.ts", "import": "./dist/core/abortReason.js" },
    "./abortReason.js": { "types": "./dist/core/abortReason.d.ts", "import": "./dist/core/abortReason.js" },
    "./orchestrationEvents": { "types": "./dist/core/orchestrationEvents.d.ts", "import": "./dist/core/orchestrationEvents.js" },
    "./orchestrationEvents.js": { "types": "./dist/core/orchestrationEvents.d.ts", "import": "./dist/core/orchestrationEvents.js" },
    "./deprecationNotice": { "types": "./dist/core/deprecationNotice.d.ts", "import": "./dist/core/deprecationNotice.js" },
    "./deprecationNotice.js": { "types": "./dist/core/deprecationNotice.d.ts", "import": "./dist/core/deprecationNotice.js" },
    "./spi": { "types": "./dist/core/spi/index.d.ts", "import": "./dist/core/spi/index.js" },
    "./spi/*": { "types": "./dist/core/spi/*.d.ts", "import": "./dist/core/spi/*.js" },
    "./identity/*": { "types": "./dist/core/identity/*.d.ts", "import": "./dist/core/identity/*.js" },
    "./external/*": { "types": "./dist/core/external/*.d.ts", "import": "./dist/core/external/*.js" },
    "./events/*": { "types": "./dist/core/events/*.d.ts", "import": "./dist/core/events/*.js" },
    "./idle/*": { "types": "./dist/core/idle/*.d.ts", "import": "./dist/core/idle/*.js" },
    "./connections/*": { "types": "./dist/core/connections/*.d.ts", "import": "./dist/core/connections/*.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "scripts": {
    "typecheck": "bun ../../app/node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "bun test",
    "build": "bun ../../app/node_modules/typescript/bin/tsc -p tsconfig.build.json && bun build src/index.ts --outdir=dist --target=bun --external @opentelemetry/api",
    "prepublishOnly": "bun run typecheck && bun run build"
  }
}
