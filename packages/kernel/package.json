{
  "name": "@openliri/kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Liri 微内核 —— 六层架构的最底层（core），零上层依赖、零跨包导入",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "scripts": {
    "typecheck": "bun ../../app/node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir=dist --target=bun --external @opentelemetry/api && bun ../../app/node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run typecheck && bun run build"
  }
}
