{
  "name": "@openliri/kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Liri 微内核 —— 六层架构的最底层（core），零上层依赖、零跨包导入",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "bun ../../app/node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir=dist --target=bun --external @opentelemetry/api",
    "prepublishOnly": "bun run typecheck && bun run build"
  }
}
