    "./DependencyRegistry": { "types": "./dist/core/DependencyRegistry.d.ts", "import": "./dist/core/DependencyRegistry.js" },
    "./DependencyRegistry.js": { "types": "./dist/core/DependencyRegistry.d.ts", "import": "./dist/core/DependencyRegistry.js" },
    "./SessionSpanTracer": { "types": "./dist/core/SessionSpanTracer.d.ts", "import": "./dist/core/SessionSpanTracer.js" },
    "./SessionSpanTracer.js": { "types": "./dist/core/SessionSpanTracer.d.ts", "import": "./dist/core/SessionSpanTracer.js" },
    "./tracingFacade": { "types": "./dist/core/tracingFacade.d.ts", "import": "./dist/core/tracingFacade.js" },
    "./tracingFacade.js": { "types": "./dist/core/tracingFacade.d.ts", "import": "./dist/core/tracingFacade.js" },
