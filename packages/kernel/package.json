{
  "name": "@openliri/kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Liri 微内核 —— 六层架构的最底层（core），零上层依赖、零跨包导入",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./paths": { "types": "./dist/core/paths.d.ts", "import": "./dist/core/paths.js" },
    "./paths.js": { "types": "./dist/core/paths.d.ts", "import": "./dist/core/paths.js" },
    "./loggerFacade": { "types": "./dist/core/loggerFacade.d.ts", "import": "./dist/core/loggerFacade.js" },
    "./loggerFacade.js": { "types": "./dist/core/loggerFacade.d.ts", "import": "./dist/core/loggerFacade.js" },
    "./errors": { "types": "./dist/core/errors.d.ts", "import": "./dist/core/errors.js" },
    "./errors.js": { "types": "./dist/core/errors.d.ts", "import": "./dist/core/errors.js" },
    "./errorHandler": { "types": "./dist/core/errorHandler.d.ts", "import": "./dist/core/errorHandler.js" },
    "./errorHandler.js": { "types": "./dist/core/errorHandler.d.ts", "import": "./dist/core/errorHandler.js" },
    "./errorCodes": { "types": "./dist/core/errorCodes.d.ts", "import": "./dist/core/errorCodes.js" },
    "./errorCodes.js": { "types": "./dist/core/errorCodes.d.ts", "import": "./dist/core/errorCodes.js" },
    "./pricing": { "types": "./dist/core/pricing.d.ts", "import": "./dist/core/pricing.js" },
    "./pricing.js": { "types": "./dist/core/pricing.d.ts", "import": "./dist/core/pricing.js" },
    "./sandboxPermission": { "types": "./dist/core/sandboxPermission.d.ts", "import": "./dist/core/sandboxPermission.js" },
    "./sandboxPermission.js": { "types": "./dist/core/sandboxPermission.d.ts", "import": "./dist/core/sandboxPermission.js" },
    "./ports": { "types": "./dist/core/ports.d.ts", "import": "./dist/core/ports.js" },
    "./ports.js": { "types": "./dist/core/ports.d.ts", "import": "./dist/core/ports.js" },
    "./httpPortFallback": { "types": "./dist/core/httpPortFallback.d.ts", "import": "./dist/core/httpPortFallback.js" },
    "./httpPortFallback.js": { "types": "./dist/core/httpPortFallback.d.ts", "import": "./dist/core/httpPortFallback.js" },
    "./ids": { "types": "./dist/core/ids.d.ts", "import": "./dist/core/ids.js" },
    "./ids.js": { "types": "./dist/core/ids.d.ts", "import": "./dist/core/ids.js" },
    "./taskStatus": { "types": "./dist/core/taskStatus.d.ts", "import": "./dist/core/taskStatus.js" },
    "./taskStatus.js": { "types": "./dist/core/taskStatus.d.ts", "import": "./dist/core/taskStatus.js" },
    "./knowledge-types": { "types": "./dist/core/knowledge-types.d.ts", "import": "./dist/core/knowledge-types.js" },
    "./knowledge-types.js": { "types": "./dist/core/knowledge-types.d.ts", "import": "./dist/core/knowledge-types.js" },
    "./mediaRoots": { "types": "./dist/core/mediaRoots.d.ts", "import": "./dist/core/mediaRoots.js" },
    "./mediaRoots.js": { "types": "./dist/core/mediaRoots.d.ts", "import": "./dist/core/mediaRoots.js" },
    "./lazySingleton": { "types": "./dist/core/lazySingleton.d.ts", "import": "./dist/core/lazySingleton.js" },
    "./lazySingleton.js": { "types": "./dist/core/lazySingleton.d.ts", "import": "./dist/core/lazySingleton.js" },
    "./LazyModuleStrategy": { "types": "./dist/core/LazyModuleStrategy.d.ts", "import": "./dist/core/LazyModuleStrategy.js" },
