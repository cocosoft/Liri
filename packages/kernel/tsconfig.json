{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "typeRoots": ["../../app/node_modules/@types"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@openliri/kernel": ["./src/index.ts"],
      "@openliri/kernel/*": ["./src/core/*"],
      "@opentelemetry/api": ["../../app/node_modules/@opentelemetry/api"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "**/*.test.ts", "**/*.test.tsx"]
}
