{
  "name": "@openliri/service",
  "version": "0.1.0",
  "private": true,
  "description": "Liri service 包 —— 六层架构 service 层中**已物理独立**的模块。仅 service 层与上层可依赖；infra / kernel 不得依赖本包。",
  "type": "module",
  "exports": {
    "./execution": {
      "types": "./src/execution/index.ts",
      "import": "./src/execution/index.ts"
    },
    "./execution/*": {
      "types": "./src/execution/*.ts",
      "import": "./src/execution/*.ts"
    },
    "./services/extractMemories": {
      "types": "./src/services/extractMemories/index.ts",
      "import": "./src/services/extractMemories/index.ts"
    },
    "./services/mcp": {
      "types": "./src/services/mcp/index.ts",
      "import": "./src/services/mcp/index.ts"
    },
    "./services/mcp/types": {
      "types": "./src/services/mcp/types/index.ts",
      "import": "./src/services/mcp/types/index.ts"
    },
    "./services/voice": {
      "types": "./src/services/voice/index.ts",
      "import": "./src/services/voice/index.ts"
    },
    "./services/*": {
      "types": "./src/services/*.ts",
      "import": "./src/services/*.ts"
    },
    "./ports/aiOpsPorts": {
      "types": "./src/ports/aiOpsPorts.ts",
      "import": "./src/ports/aiOpsPorts.ts"
    },
    "./streaming": {
      "types": "./src/streaming/index.ts",
      "import": "./src/streaming/index.ts"
    },
    "./streaming/*": {
      "types": "./src/streaming/*.ts",
      "import": "./src/streaming/*.ts"
    },
    "./voice": {
      "types": "./src/voice/index.ts",
      "import": "./src/voice/index.ts"
    },
    "./voice/*": {
      "types": "./src/voice/*.ts",
      "import": "./src/voice/*.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "import": "./src/mcp/index.ts"
    },
    "./mcp/*": {
      "types": "./src/mcp/*.ts",
      "import": "./src/mcp/*.ts"
    }
  },
  "scripts": {
    "typecheck": "bun ../../app/node_modules/typescript/bin/tsc -p tsconfig.json"
  }
}
