      "id": "BULK-001",
      "ruleId": "R00-001",
      "pattern": "app -> infra",
      "description": "应用层直接依赖基础设施层（日志/配置/错误处理等）",
      "rationale": "应用层（agent/ai/chat/tools/gateway 等）大量使用 infra 层的基础能力，需通过 Phase 2-3 逐步引入 SPI 接口解耦",
      "estimatedCount": 120,
      "createdAt": "2026-06-19",
      "expiresAt": "2026-08-18",
      "owner": "@arch-lead"
    },
