{
  "version": "1.0",
  "description": "Liri 模块到四层架构的映射。用于 lint:arch 分层检查",
  "lastUpdated": "2026-06-18",

  "layerOrder": ["kernel", "domain", "infrastructure", "interface"],
  "layerDescriptions": {
    "kernel": "最底层，无业务语义。仅包含错误类型、监控接口、基础类型、通用工具",
    "domain": "纯业务逻辑层。包含 AI、Agent、Chat、Commands、Skills 等业务领域模块",
    "infrastructure": "基础设施实现层。包含配置、核心框架、缓存、安全、运行时等实现",
    "interface": "用户交互层。包含 CLI、UI、组件、入口等交互模块"
  },

  "allowedDependencies": {
    "kernel": ["kernel"],
    "domain": ["kernel", "domain"],
    "infrastructure": ["kernel", "domain", "infrastructure"],
    "interface": ["kernel", "domain", "infrastructure", "interface"]
  },

  "modules": {
    "acp": { "layer": "domain" },
    "agent": { "layer": "domain" },
    "ai": { "layer": "domain" },
    "analytics": { "layer": "domain" },
    "auto-reply": { "layer": "domain" },
    "bridge": { "layer": "infrastructure" },
    "buddy": { "layer": "domain" },
    "bootstrap": { "layer": "infrastructure" },
    "cache": { "layer": "infrastructure" },
    "channels": { "layer": "infrastructure" },
    "chat": { "layer": "domain" },
    "chronos": { "layer": "domain" },
    "cli": { "layer": "interface" },
    "commands": { "layer": "domain" },
    "common": { "layer": "kernel" },
    "components": { "layer": "interface" },
    "config": { "layer": "infrastructure" },
    "constants": { "layer": "kernel" },
    "context": { "layer": "domain" },
    "context-engine": { "layer": "domain" },
    "core": { "layer": "infrastructure" },
    "cost": { "layer": "domain" },
    "daemon": { "layer": "infrastructure" },
    "diagnostics": { "layer": "infrastructure" },
    "docs": { "layer": "domain" },
    "dream": { "layer": "domain" },
    "entrypoints": { "layer": "interface" },
    "error": { "layer": "kernel" },
    "featureflags": { "layer": "infrastructure" },
    "flows": { "layer": "domain" },
    "governance": { "layer": "infrastructure" },
