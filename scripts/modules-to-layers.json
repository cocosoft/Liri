    "main.ts": { "layer": "interface" },
    "mcp": { "layer": "infrastructure" },
    "media": { "layer": "domain" },
    "memory": { "layer": "domain" },
    "models": { "layer": "domain" },
    "modules": { "layer": "infrastructure" },
    "monitor.ts": { "layer": "kernel" },
