{
  "version": "1.0",
  "description": "Liri 模块分层映射。每个模块/目录归属一个层，lint:arch 据此检查跨层依赖",
  "lastUpdated": "2026-09-30",

  "layerOrder": ["entry", "ui", "app", "service", "infra", "core"],

  "allowedDependencies": {
    "entry": ["entry", "ui", "app", "service", "infra", "core"],
    "ui":     ["ui", "app", "service", "infra", "core"],
    "app":    ["app", "service", "infra", "core"],
    "service":["service", "infra", "core"],
    "infra":  ["infra", "core"],
    "core":   ["core"]
  },

  "modules": {
    "appState":  { "layer": "app", "description": "应用级状态容器（AppState / AppStateStore / PYAppStateStore）。2026-10-01 **D-164 由 `system/state/` 改归 app** —— 实测其消费方**全为 app/entry**（buddy · ai · hooks/notifs · entrypoints/mcp）+ 同模块，**无 infra/service/core 消费者**；原置 `system`(infra) 导致 3 条 `system`(infra) → `mcp`/`plugins`/`tasks`(app) 倒挂（D-158 清单 S1/S2/S3）。改归后三边同消（infra→app 变 app→app）。同 D-84(`hooks` ui→app) / D-67(`mcp` core→service) / D-120(`modules` core→app) 手法。" },
    "entrypoints":  { "layer": "entry", "description": "应用入口" },
    "bootstrap":    { "layer": "entry", "description": "启动引导" },
    "main.ts":      { "layer": "entry", "description": "主入口" },
    "pyapp.ts":     { "layer": "entry", "description": "PyApp 兼容入口" },
    "healthcheck.ts": { "layer": "entry", "description": "健康检查" },
    "monitor.ts":   { "layer": "entry", "description": "进程监控" },
    "index.ts":     { "layer": "entry", "description": "模块入口" },

    "ink":      { "layer": "ui", "description": "Ink UI 渲染引擎" },
    "ui":       { "layer": "ui", "description": "用户界面" },
    "components": { "layer": "ui", "description": "UI 组件" },
    "hooks":    { "layer": "app", "description": "钩子系统（运行时钩子链 core/executors/managers/types/utils/postSampling + 部分 React hooks use*.ts）；2026-09-30 D-84 由 ui 改归 app —— 实测其**零 ui 依赖**（仅用 error/monitoring/cost=infra 与 commands=app），却被 app(9 文件)/infra(2 文件) 消费；**混合体待后续拆分**（React hooks 与运行时钩子链分离）" },
    "cli":      { "layer": "ui", "description": "命令行界面" },
    "vim":      { "layer": "ui", "description": "Vim 模式" },
    "keybindings": { "layer": "ui", "description": "键盘绑定（含 React 组件/Context）" },

    "commands": { "layer": "app", "description": "命令处理" },
    "tools":    { "layer": "app", "description": "工具管理" },
    "flows":    { "layer": "app", "description": "工作流引擎" },
    "skills":   { "layer": "app", "description": "技能系统" },
    "wizard":   { "layer": "app", "description": "配置向导" },
    "agent":    { "layer": "app", "description": "Agent 系统" },
    "ai":       { "layer": "app", "description": "AI 模型路由" },
    "models":   { "layer": "app", "description": "模型类型" },
    "chat":     { "layer": "app", "description": "聊天管理" },
    "context":  { "layer": "app", "description": "上下文管理" },
    "query":    { "layer": "app", "description": "查询引擎 (TAOR)" },
    "auto-reply": { "layer": "app", "description": "自动回复" },
    "docs":     { "layer": "app", "description": "文档帮助" },
    "tasks":    { "layer": "app", "description": "任务系统" },
    "buddy":    { "layer": "app", "description": "虚拟伙伴" },
    "dream":    { "layer": "app", "description": "梦境模块" },
    "knowledge":{ "layer": "app", "description": "知识库" },
    "governance": { "layer": "app", "description": "治理模块" },
    "sandbox":  { "layer": "app", "description": "沙箱执行" },
    "scripts":  { "layer": "app", "description": "内部脚本" },
    "plugin-sdk": { "layer": "app", "description": "插件 SDK" },
    "plugins":  { "layer": "app", "description": "插件系统" },

    "context-engine": { "layer": "app", "description": "上下文引擎（与 context 同域）" },
    "evals":    { "layer": "app", "description": "Agent 评测框架（runner/scoring/sandbox/反作弊）" },
    "project":  { "layer": "app", "description": "项目域（成果/历史/需求追踪/迁移）" },
    "promptSuggestion": { "layer": "app", "description": "提示建议（消费 ai/chat）" },
    "subagent": { "layer": "app", "description": "子代理管理（工厂/通信/Teammate）" },
    "subagents": { "layer": "app", "description": "子代理事件泵（与 subagent 同域）" },
    "testing":  { "layer": "app", "description": "测试辅助（依赖面宽，故归 app 而非 infra）" },
    "tool":     { "layer": "app", "description": "工具结果/作用域注册（与 tools 同域）" },
    "workspace": { "layer": "app", "description": "工作空间域（.liri 目录管理/工作项生命周期）" },
    "workspaces": { "layer": "app", "description": "工作区注册/扫描/清理/Git" },

    "session":  { "layer": "service", "description": "会话管理" },
    "bridge":   { "layer": "service", "description": "桥接模块" },
    "channels": { "layer": "service", "description": "通道系统" },
    "streaming":{ "layer": "service", "description": "流式输出" },
    "services": { "layer": "service", "description": "通用服务" },
    "voice":    { "layer": "service", "description": "语音服务" },
    "infrastructure": { "layer": "service", "description": "HTTP 服务层（LocalHTTPService + handlers + 17 路由子域）" },
    "remote":   { "layer": "service", "description": "远程接入（SSH 连接池/远程会话/文件同步）" },
    "runtime":  { "layer": "service", "description": "运行时 API（CoreAPI/Inbox/通知持久化）" },

    "config":   { "layer": "infra", "description": "配置管理" },
    "error":    { "layer": "infra", "description": "错误处理" },
    "monitoring": { "layer": "infra", "description": "监控日志" },
    "cost":     { "layer": "infra", "description": "成本追踪" },
    "analytics":{ "layer": "infra", "description": "数据分析" },
    "constants":{ "layer": "infra", "description": "常量定义" },
    "common":   { "layer": "infra", "description": "公共工具" },
    "types":    { "layer": "core", "description": "类型定义（纯类型、无出向依赖；归 core 后各层引用自动合法）" },
    "utils":    { "layer": "infra", "description": "通用工具" },
    "state":    { "layer": "infra", "description": "状态管理" },
    "memory":   { "layer": "infra", "description": "记忆存储" },
    "cache":    { "layer": "infra", "description": "缓存系统" },
    "daemon":   { "layer": "infra", "description": "守护进程" },
    "media":    { "layer": "infra", "description": "媒体处理" },
    "i18n":     { "layer": "infra", "description": "国际化" },
    "lsp":      { "layer": "infra", "description": "LSP 客户端" },
    "chronos":  { "layer": "infra", "description": "定时任务" },
    "security": { "layer": "infra", "description": "安全模块" },
    "oauth":    { "layer": "infra", "description": "OAuth 认证" },
    "permission": { "layer": "infra", "description": "权限控制" },

    "diagnostics": { "layer": "infra", "description": "诊断/健康检查（与 monitoring 同类）" },
    "featureflags": { "layer": "infra", "description": "特性开关" },
    "performance": { "layer": "infra", "description": "性能采样/优化/启动剖析" },
    "system":   { "layer": "infra", "description": "聚合容器（auth/i18n/state/theme 基础能力）" },
    "trace-recording": { "layer": "infra", "description": "AI 轨迹录制（观测）" },

    "core":     { "layer": "core", "description": "核心框架" },
    "modules":  { "layer": "app", "description": "模块系统（注册表/定义/初始化/懒加载策略）。2026-09-30 D-120 由 **core 改归 app** —— 实测其**出向依赖**为 core / tools(app) / tasks(app) / runtime(service) 及动态的 services/infrastructure/cost/session，**需要 core 以上各层**；归 core（其 allowedDependencies 仅含 core）会把全部出向判为跨层。改归 app 后：出向到 app/service/infra/core 合法（已豁免与 R00-003 同步出清），入向由 ≥app 各层承担（已同步修好原 core/infra 入向 4 处）" },
    "acp":      { "layer": "core", "description": "ACP 协议" },
    "mcp":      { "layer": "service", "description": "MCP 协议（增强层，静态引用标准层 services/mcp；2026-09-30 D-67 由 core 改归 service，对齐 §1.11「增强层引用标准层」语义）" }
  }
}
